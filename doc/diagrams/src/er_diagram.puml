@startuml er_diagram
title Entity-Relationship Diagram

!theme spacelab
skinparam BackgroundColor white
skinparam padding 8

entity "cities" as cities {
    * **id** : INT <<PK>>
    --
    name : VARCHAR(255)
}

entity "streets" as streets {
    * **id** : INT <<PK>>
    --
    name : VARCHAR(255)
    * city_id : INT <<FK>>
}

entity "markets" as markets {
    * **id** : INT <<PK>>
    --
    name : VARCHAR(255)
    * street_id : INT <<FK>>
    house_number : VARCHAR(255)
    opening_time : TIME
    closing_time : TIME
}

cities ||--o{ streets : "city_id"
streets ||--o{ markets : "street_id"

@enduml
